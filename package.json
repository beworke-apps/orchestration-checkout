{
  "name": "@heroui-pro/template-dashboard",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "audit": "pnpm audit --audit-level=high --prod",
    "commit": "cz",
    "prepare": "husky",
    "clean": "rm -rf .next node_modules .turbo dist"
  },
  "exports": {
    "./src/*": "./src/*.tsx",
    "./src/data/*": "./src/data/*.ts",
    "./src/nav-items": "./src/nav-items.ts"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.18.0",
    "@heroui-pro/react": "latest",
    "@heroui/react": "3.0.5",
    "@heroui/styles": "3.0.5",
    "@hookform/resolvers": "^5.4.0",
    "@number-flow/react": ">=0.5.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@types/js-cookie": "^3.0.6",
    "dayjs": "^1.11.20",
    "embla-carousel": ">=8.6.0",
    "embla-carousel-react": ">=8.6.0",
    "js-cookie": "^3.0.7",
    "motion": ">=12.12.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-aria-components": ">=1.17.0",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.1",
    "react-redux": "^9.3.0",
    "react-resizable-panels": ">=4.10.0",
    "recharts": "3.8.0",
    "tailwind-merge": ">=3.4.0",
    "tailwind-variants": ">=3.2.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "24.7.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "postcss": "8.5.9",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "heroui-pro",
      "@heroui-pro/react",
      "heroui-native-pro"
    ]
  }
}
